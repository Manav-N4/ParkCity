{
  "expo": {
    "name": "parkcity",
    "slug": "parkcity",
    "scheme": "parkcity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aadee3207.parkcity"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aadee3207.parkcity"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ParkCity does not access your gallery for claim photos.",
          "cameraPermission": "ParkCity needs camera access to photograph the parking spot.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "32a2bff1-b10b-49eb-989a-5a42c34f776c"
      }
    },
    "owner": "manav_nayak"
  }
}
